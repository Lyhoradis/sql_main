## Встроенные функции - на странице справочника функций https://sql-academy.org/handbook
# upper
''' SELECT UPPER('Hello world') AS upper_string; '''
# lower (понижает регистр)
''' SELECT LOWER('SQL Academy') AS lower_string; '''
# year (возвращает год от запрашиваемой даты)
''' SELECT YEAR('2022-06-16') AS year; '''
# instr
''' SELECT INSTR('foobarbar', 'bar'); вернёт 4, потому что подстрока «bar» начинается с 4-го символа. '''
# length - длина строки
''' SELECT LENGTH('sql-academy') AS str_length; '''
# код считает длину каждого имени, взятого из таблицы с сайта
''' SELECT member_name,
	LENGTH(member_name) AS fullname_length
FROM FamilyMembers; '''
# результат одной функции - аргумент для второй
'''SELECT UPPER(LEFT('sql-academy', 3)) AS str; '''
# если надо разделить данные одного столбца и вывести часть после пробела
''' SELECT 
    member_name,
    CHAR_LENGTH(SUBSTRING_INDEX(member_name, ' ', -1)) AS lastname_length
FROM FamilyMembers; '''
# исключение повторов
''' SELECT DISTINCT class FROM Student_in_class; '''

# ограничение where
''' SELECT * FROM Student
WHERE first_name = "Grigorij" AND YEAR(birthday) > 2000; '''

# отсутствует ли значение в поле? Не отсутствует = is not null
''' SELECT * FROM Teacher
WHERE middle_name IS NULL; '''

# между мин и макс
''' ... WHERE field >= min AND field <= max '''

# входит ли значение в список определенных значений
''' SELECT * FROM FamilyMembers
WHERE status IN ('father', 'mother'); '''

# сопоставление
'''WHERE поле_таблицы LIKE 'text%' ''' #начинается на
''' WHERE поле_таблицы LIKE '%text' ''' #заканчивается на
''' WHERE поле_таблицы LIKE '_ext' ''' #Сопоставляется строкам, имеющим длину 4 символа, при этом 3 последних обязательно должны быть «ext».
''' SELECT job_id FROM Jobs
WHERE progress LIKE '3\%'; ''' #экранирование символа через \

#явное указание символа экранирования 
''' SELECT job_id FROM Jobs
WHERE progress LIKE '3!%' ESCAPE '!'; '''

# Регистронезависимость: По умолчанию регулярные выражения в MySQL не чувствительны к регистру.
Например, выражение REGEXP 'abc' найдёт строку и abc, и Abc, и ABC.

# номер не содержит 2 и 8
''' SELECT * FROM Users WHERE phone_number REGEXP '^[0-9^28]*$' '''

# сортировка ORDER BY
''' SELECT name FROM Company ORDER BY name; '''

# Правило сортировки применяется только к тому столбцу, за которым оно следует.
''' ORDER BY столбец_1, столбец_2 DESC '''
# не то же самое, что
''' ORDER BY столбец_1 DESC, столбец_2 DESC '''

# среднее значение AVG
''' SELECT home_type, AVG(price) as avg_price FROM Rooms
GROUP BY home_type '''

# для фильтрации групп вместо WHERE
''' SELECT home_type, AVG(price) as avg_price FROM Rooms
GROUP BY home_type
HAVING avg_price > 50 '''
